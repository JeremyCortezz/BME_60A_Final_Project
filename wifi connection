
% BME 60A - Wireless ESP32 Connection

% Clear previous connection
clear a

% Connect to ESP32 through Wi-Fi
a = arduino("192.168.0.49", "ESP32-WROOM-DevKitC");

% Turn LED ON at D2
writeDigitalPin(a, "D2", 1);

% Wait 2 seconds
pause(2);

% Turn LED OFF
writeDigitalPin(a, "D2", 0);

% Display confirmation
disp("Wireless ESP32 control successful!");

% 1. connect the esp32 to your mac using a USB cable and open matlab
% 2. in the matlab command window, clear any existing connections by entering clear a and arduinosetup
