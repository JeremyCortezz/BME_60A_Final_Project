close all; clear; clc;
a = arduino("COM4","ESP32-WROOM-DevKitV1");
ledPin = 'D21';
configurePin(a, ledPin, 'DigitalOutput');
% configurePin(a, 'D34', 'AnalogInput');
% Not sure if needed?
reading = zeros(1,10);
h = plot(1:10, 10);

while true
    writeDigitalPin(a, ledPin, 1);
    pause(0.5);
    writeDigitalPin(a, ledPin, 0);
    pause(0.5);
    reading = [reading(2:end), readVoltage(a, 'D34')];
    set(h, 'YData', reading);
    drawnow limitrate;
end
